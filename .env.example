# LifeReel Biography environment template
#
# 本模板列出项目支持的 123 个配置项；生产 .env 可以更短。
# 服务器当前使用 82 个变量，其余 41 个有代码或 Compose 默认值，省略后仍按默认值运行。
# 模板与服务器的变量集合关系：服务器变量 ⊆ 本模板变量。不要把生产密钥提交到 Git。

# ===== 基础运行与网络 =====
# 应用名称、监听、跨域、开发代理和服务访问密钥。
API_ACCESS_KEY=
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
APP_NAME=LifeReel Biography API
CONTAINER_DNS_SERVER=223.5.5.5
LOG_LEVEL=INFO
VITE_DEV_API_TARGET=http://localhost:8000

# ===== 数据库、缓存与队列 =====
# 数据库连接、PostgreSQL 容器、Redis、租户和任务队列。
AUTO_CREATE_SCHEMA=true
DATABASE_URL=postgresql+psycopg://lifereel:lifereel@localhost:5432/lifereel
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
EXECUTE_MOCK_JOBS_INLINE=true
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PASSWORD=replace-with-a-private-database-password
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
WORKER_QUEUE=lifereel:jobs

# ===== 对象存储与媒体限制 =====
# OSS/S3、MinIO、本地存储和上传大小限制。
LOCAL_STORAGE_PATH=../../data/private
MAX_EVIDENCE_AUDIO_BYTES=524288000
MAX_EVIDENCE_DOCUMENT_BYTES=52428800
MAX_EVIDENCE_IMAGE_BYTES=20971520
MAX_EVIDENCE_VIDEO_BYTES=2147483648
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
OSS_DIRECT_UPLOAD_ENABLED=false
S3_ACCESS_KEY=lifereel
S3_ADDRESSING_STYLE=auto
S3_BUCKET=lifereel-private
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION_NAME=
S3_SECRET_KEY=change-me-in-production
S3_SERVER_SIDE_ENCRYPTION=
STORAGE_BACKEND=local

# ===== 账户、注册与短信 =====
# 登录令牌、初始管理员、注册开关和短信服务。
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_SECRET=replace-with-another-long-random-secret
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_NAME=家庭管理员
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-initial-password
REGISTRATION_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_CODE_PARAMETER=code
SMS_CODE_TTL_SECONDS=300
SMS_DAILY_LIMIT=500
SMS_ENABLED=false
SMS_RESET_TEMPLATE_CODE=
SMS_SECURITY_TEMPLATE_CODE=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ===== 微信与抖音小程序 =====
# 小程序开关、平台身份、登录接口和会话有效期。AppSecret 只填服务器 .env。
DOUYIN_MINI_APP_ID=
DOUYIN_MINI_APP_SECRET=
DOUYIN_MINI_LOGIN_URL=https://developer.toutiao.com/api/apps/v2/jscode2session
MINI_PROGRAM_ENABLED=false
MINI_PROGRAM_HTTP_TIMEOUT_SECONDS=8
MINI_PROGRAM_REGISTRATION_ENABLED=false
MINI_REFRESH_DAYS=30
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_MINI_LOGIN_URL=https://api.weixin.qq.com/sns/jscode2session

# ===== 账单与收款 =====
# 计费规则和人工收款占位开关。
BILLING_PRICE_VERSION=standard-2026-09-luna20
BILLING_SCRIPT_CHAPTER_CENTS=40
BILLING_TEXT_MODE=per_successful_chapter_update
BILLING_VIDEO_CENTS_PER_SECOND=80
BILLING_VIDEO_MODE=tokens
BILLING_VIDEO_RESERVE_CENTS=2400
BILLING_WELCOME_BONUS_CENTS=2000
MANUAL_ALIPAY_ENABLED=false
MANUAL_ALIPAY_QR_PATH=data/payments/alipay-qr.png
MANUAL_ALIPAY_RECIPIENT_ACCOUNT=
MANUAL_ALIPAY_RECIPIENT_NAME=
MANUAL_WECHAT_ENABLED=false
MANUAL_WECHAT_QR_PATH=data/payments/wechat-qr.png

# ===== AI、语音、识别与视频供应商 =====
# 模型供应商、媒体服务、语音服务、视觉服务和视频生成。
ASR_MODEL=small
ASR_PROVIDER=faster-whisper
DOUBAO_REALTIME_API_KEY=
DOUBAO_REALTIME_VOICE=zh_female_xiaohe_jupiter_bigtts
IMAGE_PROVIDER=mock
INTERVIEW_LLM_MODEL=gpt-5.6-luna
LLM_PROVIDER=mock
MEDIA_PROVIDER_API_KEY=
MEDIA_PROVIDER_BASE_URL=
MEDIA_PROVIDER_NAME=generic-media
MEDIA_PROVIDER_POLL_SECONDS=2
MEDIA_PROVIDER_TIMEOUT_SECONDS=900
MEMORY_LLM_MODEL=gpt-5.6-luna
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
PHOTO_REDRAW_PROVIDER=disabled
PHOTO_RESTORATION_PROVIDER=seedream
REALTIME_VOICE_MAX_SECONDS=900
REALTIME_VOICE_PROVIDER=disabled
SCRIPT_LLM_MODEL=gpt-5.6-luna
SILICONFLOW_API_KEY=
VIDEO_PROVIDER=mock
VIDEO_REFERENCE_STYLE=original
VISION_LLM_MODEL=gpt-5.6-luna
VOICE_PROVIDER=mock
VOLCENGINE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_API_KEY=
VOLCENGINE_VIDEO_DURATION=5
VOLCENGINE_VIDEO_GENERATE_AUDIO=true
VOLCENGINE_VIDEO_MODEL=doubao-seedance-2-0-mini-260615
VOLCENGINE_VIDEO_POLL_SECONDS=10
VOLCENGINE_VIDEO_RATIO=16:9
VOLCENGINE_VIDEO_RESOLUTION=720p
VOLCENGINE_VIDEO_TIMEOUT_SECONDS=900
VOLCENGINE_VIDEO_WATERMARK=true
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_MODEL_PATH=

# ===== 模型超时、流式与处理预算 =====
# 模型 HTTP 超时、流式响应、文件解析预算、worker 超时和并发。
DOCUMENT_EXTRACT_MAX_CHARS=16000
DOCUMENT_EXTRACT_MAX_PAGES=200
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_POOL_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=180
LLM_STREAM=false
LLM_STREAM_MAX_SECONDS=600
LLM_WRITE_TIMEOUT_SECONDS=30
SCRIPT_INPUT_MAX_CHARS=48000
WORKER_INTERVIEW_TIMEOUT_SECONDS=3600
WORKER_VIDEO_TIMEOUT_SECONDS=7200

# ===== 网关与兼容配置 =====
# 网关上传上限及保留的兼容配置。
NGINX_CLIENT_MAX_BODY_SIZE=2050m
